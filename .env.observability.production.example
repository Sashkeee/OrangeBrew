# Store actual production values in .env.production.local or the secret store.
# This is a configuration example, not a credential set or a single-node broker.
KAFKA_BROKERS=kafka-1.example:9093,kafka-2.example:9093,kafka-3.example:9093
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=orangebrew-backend
KAFKA_SASL_PASSWORD=REPLACE_WITH_BACKEND_SERVICE_SECRET
KAFKA_FILEBEAT_USERNAME=orangebrew-filebeat
KAFKA_FILEBEAT_PASSWORD=REPLACE_WITH_COLLECTOR_SERVICE_SECRET
KAFKA_LOGSTASH_JAAS_CONFIG='org.apache.kafka.common.security.scram.ScramLoginModule required username="orangebrew-logstash" password="REPLACE_WITH_INDEXER_SECRET";'
KAFKA_TRUSTSTORE_PASSWORD=REPLACE_WITH_TRUSTSTORE_PASSWORD
ELASTICSEARCH_URL=https://elasticsearch.example:9200
LOGSTASH_USERNAME=orangebrew_ingest
LOGSTASH_PASSWORD=REPLACE_WITH_INGEST_SERVICE_SECRET
OBSERVABILITY_CERTS_DIR=./.local/production-certs
