# Environment
PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
APP_ENV=development
LOG_FORMAT=json
LOG_LEVEL=info
SERVICE_VERSION=development
SERIAL_PORT=COM3
BAUD_RATE=115200
CONNECTION_TYPE=mock

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional env credentials belong to this one user; others configure their own.
TELEGRAM_OWNER_USER_ID=
NOTIFICATIONS_TRANSPORT=direct
NOTIFICATION_TTL_MS=900000

# Database
DB_PATH=./data/orangebrew.db
SQLITE_SYNCHRONOUS=FULL

# Durable process events; API/control run without Kafka by default.
EVENTS_CAPTURE_ENABLED=true
KAFKA_PUBLISH_ENABLED=false
PROCESS_PROJECTION_ENABLED=true
KAFKA_BROKERS=
KAFKA_CLIENT_ID=orangebrew-backend
KAFKA_SSL=false
KAFKA_SSL_CA_LOCATION=
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_DELIVERY_TIMEOUT_MS=10000
OUTBOX_MAX_PENDING_EVENTS=100000
OUTBOX_MAX_PENDING_BYTES=67108864
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000
OUTBOX_PUBLISHED_RETENTION_HOURS=24
